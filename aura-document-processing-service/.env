APP_NAME='aura document processing service'
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
ENVIRONMENT=development
SERVICE_API_KEY=service_api_key

# ===== TEXT CLEANER SETTINGS =====

TEXT_CLEANER_ACTIVE_TYPE=simple

# ===== TEXT SPLITTER SETTINGS =====

TEXT_SPLITTER_ACTIVE_TYPE=huggingface

TEXT_SPLITTER_HUGGINGFACE_MODEL=intfloat/multilingual-e5-large
TEXT_SPLITTER_HUGGINGFACE_DEVICE=cuda
TEXT_SPLITTER_HUGGINGFACE_BREAKPOINT_THRESHOLD_AMOUNT=100
TEXT_SPLITTER_HUGGINGFACE_BREAKPOINT_THRESHOLD_TYPE=standard_deviation

TEXT_SPLITTER_RECURSIVE_SPLIT_SIZE=500
TEXT_SPLITTER_RECURSIVE_SPLIT_OVERLAP=50
TEXT_SPLITTER_RECURSIVE_ENCODING_NAME=cl100k_base

# ===== EMBEDDER SETTINGS =====

EMBEDDER_ACTIVE_TYPE=huggingface

EMBEDDER_HUGGINGFACE_MODEL=intfloat/multilingual-e5-large
EMBEDDER_HUGGINGFACE_DEVICE=cuda

EMBEDDER_OLLAMA_MODEL=qwen3-embedding:4b
EMBEDDER_OLLAMA_URL=http://localhost:11434

# ===== RABBITMQ MANAGER SETTINGS =====

RABBITMQ_MANAGER_URL=amqp://aura_root:aura_password@localhost:5672/

# ===== REDIS CLIENT SETTINGS =====

REDIS_CLIENT_URL=redis://127.0.0.1:6379/4

# ===== DATABASE MANAGER SETTINGS =====

DATABASE_MANAGER_DRIVER=postgresql+asyncpg
DATABASE_MANAGER_USER=aura_root
DATABASE_MANAGER_PASSWORD=aura_password
DATABASE_MANAGER_HOST=localhost
DATABASE_MANAGER_PORT=5432
DATABASE_MANAGER_NAME=aura_db

# ===== MINIO MANAGER SETTINGS =====

MINIO_MANAGER_ENDPOINT=localhost:9000
MINIO_MANAGER_ACCESS_KEY=aura_root
MINIO_MANAGER_SECRET_KEY=aura_password

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://localhost:8002/auth/validate

# ===== LLM PROVIDER SETTINGS =====

LLM_PROVIDER_CLASSIFY_DOCUMENT_URL=http://localhost:8001/api/v1/document-classify
LLM_PROVIDER_ENRICH_FRAGMENT_URL=http://localhost:8001/api/v1/fragment-enrich
LLM_PROVIDER_EXTRACT_ENTITIES_RELATIONS_URL=http://localhost:8001/api/v1/graph-extraction
LLM_PROVIDER_TRANSLATE_GRAPH_QUERY_URL=http://localhost:8001/api/v1/graph-query-translation

# ===== KNOWLEDGE GRAPH SETTINGS =====

KNOWLEDGE_GRAPH_ENABLED=false

# ===== NEO4J MANAGER SETTINGS =====

NEO4J_MANAGER_URI=neo4j://localhost:7687
NEO4J_MANAGER_USER=neo4j
NEO4J_MANAGER_PASSWORD=aura_password
NEO4J_MANAGER_DATABASE=neo4j

# ===== DOCUMENT COLLECTION SERVICE =====
DOCUMENT_COLLECTION_SERVICE_ACCESSIBLE_COLLECTIONS_URL=http://localhost:8005/api/v1/user-authorizations
DOCUMENT_COLLECTION_SERVICE_SERVICE_API_KEY=service_api_key
