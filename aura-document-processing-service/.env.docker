APP_NAME='Aura document processing service'
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

DB_HOST=db
DB_PORT=5432
DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_DRIVER=postgresql+psycopg2

MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=aura_root
MINIO_SECRET_KEY=aura_password
MINIO_SECURE=false

OLLAMA_BASE_URL=http://llm:11434
TEXT_CLEANER_TYPE=space
TEXT_SPLITTER_TYPE=recursive
EMBEDDER_TYPE=ollama
VECTOR_DIMENSION=768
SPLIT_SIZE=600
SPLIT_OVERLAP=60

AUTHENTICATION_VALIDATE_TOKEN_URL=http://localhost:8080/auth/validate
AUTHENTICATION_VERIFY_PERMISSIONS_URL=http://localhost:8080/auth/verify-permissions
AUTHENTICATION_GET_USER_BY_TOKEN_URL=http://localhost:8080/auth/user

MAX_FILE_SIZE_MB=20

ENVIRONMENT=development
