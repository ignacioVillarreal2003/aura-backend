APP_NAME='aura document processing service'
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

ENVIRONMENT=development

# ===== EMBEDDER SETTINGS =====
EMBEDDER_ACTIVE_TYPE=huggingface

EMBEDDER_HUGGINGFACE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDER_HUGGINGFACE_DEVICE=cpu

EMBEDDER_OLLAMA_MODEL=nomic-embed-text-v2-moe
EMBEDDER_OLLAMA_BASE_URL=http://llm:11434

# ===== TEXT SPLITTER SETTINGS =====

TEXT_SPLITTER_ACTIVE_TYPE=recursive

TEXT_SPLITTER_HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_SPLITTER_HUGGINGFACE_DEVICE=cpu
TEXT_SPLITTER_HUGGINGFACE_BREAKPOINT_THRESHOLD_TYPE=percentile

TEXT_SPLITTER_RECURSIVE_SPLIT_SIZE=512
TEXT_SPLITTER_RECURSIVE_SPLIT_OVERLAP=50
TEXT_SPLITTER_RECURSIVE_ENCODING_NAME=cl100k_base

# ===== TEXT CLEANER SETTINGS =====

TEXT_CLEANER_ACTIVE_TYPE=simple

# ===== FRAGMENT SETTINGS =====

FRAGMENT_VECTOR_DIMENSION=384

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://mock-auth:8080/auth/validate

# ===== DATABASE MANAGER SETTINGS =====

DATABASE_MANAGER_DRIVER=postgresql+asyncpg
DATABASE_MANAGER_USER=aura_root
DATABASE_MANAGER_PASSWORD=aura_password
DATABASE_MANAGER_HOST=db
DATABASE_MANAGER_PORT=5432
DATABASE_MANAGER_NAME=aura_db

# ===== MINIO MANAGER SETTINGS =====

MINIO_MANAGER_ENDPOINT=storage:9000
MINIO_MANAGER_ACCESS_KEY=aura_root
MINIO_MANAGER_SECRET_KEY=aura_password
