APP_NAME='Aura document processing service'
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

ENVIRONMENT=development

# ===== FRAGMENT SETTINGS =====

FRAGMENT_VECTOR_DIMENSION=768

# ===== CREATE DOCUMENT SETTINGS =====

CREATE_DOCUMENT_MAX_FILE_SIZE_MB=50
CREATE_DOCUMENT_MIN_FILE_SIZE_BYTES=1

CREATE_DOCUMENT_CHUNK_SIZE_BYTES=65536

CREATE_DOCUMENT_TEMP_DIR_PREFIX=doc_uploads

CREATE_DOCUMENT_BACKGROUND_PROCESSING_TIMEOUT=300

CREATE_DOCUMENT_DEDUPLICATION_ENABLED=false
CREATE_DOCUMENT_DEDUPLICATION_WINDOW_HOURS=24

# ===== DOCUMENT QUERY SETTINGS =====

DOCUMENT_QUERY_PAGE_SIZE=10

# ===== DOCUMENT INGESTION SETTINGS =====

DOCUMENT_INGESTION_TEXT_CLEANER_TYPE=simple
DOCUMENT_INGESTION_TEXT_SPLITTER_TYPE=recursive
DOCUMENT_INGESTION_EMBEDDER_TYPE=ollama

DOCUMENT_INGESTION_BATCH_SIZE=100

# ===== RETRIEVE DOCUMENT SETTINGS =====

RETRIEVE_DOCUMENT_EMBEDDER_TYPE=ollama

RETRIEVE_DOCUMENT_MAX_FRAGMENTS=5

RETRIEVE_DOCUMENT_MAX_QUESTION_LENGTH=10000
RETRIEVE_DOCUMENT_MIN_QUESTION_LENGTH=1

# ===== DATABASE MANAGER SETTINGS =====

DATABASE_MANAGER_DRIVER=postgresql+asyncpg
DATABASE_MANAGER_USER=aura_root
DATABASE_MANAGER_PASSWORD=aura_password
DATABASE_MANAGER_HOST=localhost
DATABASE_MANAGER_PORT=5432
DATABASE_MANAGER_NAME=aura_db

DATABASE_MANAGER_POOL_PERSISTENT_CONNECTIONS=10
DATABASE_MANAGER_POOL_OVERFLOW_CONNECTIONS=20
DATABASE_MANAGER_POOL_CHECKOUT_TIMEOUT_SECONDS=30.0
DATABASE_MANAGER_POOL_RECYCLE_SECONDS=3600
DATABASE_MANAGER_POOL_LIVENESS_PROBE=True

DATABASE_MANAGER_TCP_CONNECT_TIMEOUT_SECONDS=10
DATABASE_MANAGER_QUERY_EXECUTION_TIMEOUT_SECONDS=30

DATABASE_MANAGER_ECHO_SQL=false
DATABASE_MANAGER_QUERY_LOGGING_ENABLED=false
DATABASE_MANAGER_PG_APPLICATION_NAME=app

DATABASE_MANAGER_SSL_ENABLED=false
DATABASE_MANAGER_SSL_VERIFY_SERVER_CERTIFICATE=true
DATABASE_MANAGER_SSL_CLIENT_CERT_PATH=
DATABASE_MANAGER_SSL_CLIENT_KEY_PATH=
DATABASE_MANAGER_SSL_CA_CERT_PATH=

# ===== MINIO MANAGER SETTINGS =====

MINIO_MANAGER_ENDPOINT=localhost:9000
MINIO_MANAGER_ACCESS_KEY=aura_root
MINIO_MANAGER_SECRET_KEY=aura_password
MINIO_MANAGER_USE_TLS=false
MINIO_MANAGER_REGION=us-east-1

MINIO_MANAGER_CONNECTION_POOL_SIZE=10
MINIO_MANAGER_TCP_CONNECT_TIMEOUT_SECONDS=10.0
MINIO_MANAGER_SOCKET_READ_TIMEOUT_SECONDS=30.0
MINIO_MANAGER_SOCKET_WRITE_TIMEOUT_SECONDS=60.0

MINIO_MANAGER_RETRY_MAX_ATTEMPTS=3
MINIO_MANAGER_RETRY_BACKOFF_MULTIPLIER=1.0
MINIO_MANAGER_RETRY_BACKOFF_MIN_SECONDS=1.0
MINIO_MANAGER_RETRY_BACKOFF_MAX_SECONDS=10.0

MINIO_MANAGER_PRESIGNED_URL_EXPIRY_SECONDS=3600

MINIO_MANAGER_MULTIPART_UPLOAD_THRESHOLD_BYTES=5242880
MINIO_MANAGER_MULTIPART_UPLOAD_CHUNK_SIZE_BYTES=5242880

MINIO_MANAGER_DEFAULT_BUCKET_NAME=
MINIO_MANAGER_AUTO_CREATE_BUCKET_IF_MISSING=false

MINIO_MANAGER_METRICS_ENABLED=true

# ===== DOCUMENT STORAGE SETTINGS =====

DOCUMENT_STORAGE_BUCKET_NAME=documents
DOCUMENT_STORAGE_AUTO_CREATE_BUCKET_IF_MISSING=true

DOCUMENT_STORAGE_OBJECT_KEY_PREFIX=documents
DOCUMENT_STORAGE_ORGANIZE_OBJECTS_BY_DATE=true
DOCUMENT_STORAGE_PRESERVE_ORIGINAL_FILENAME_AS_STEM=false
DOCUMENT_STORAGE_UUID_PREFIX_ON_PRESERVED_STEM=true
DOCUMENT_STORAGE_MAX_OBJECT_STEM_LENGTH=255

DOCUMENT_STORAGE_ALLOWED_FILE_EXTENSIONS=pdf,doc,docx
DOCUMENT_STORAGE_MAX_FILE_SIZE_BYTES=104857600
DOCUMENT_STORAGE_MIN_FILE_SIZE_BYTES=1

DOCUMENT_STORAGE_ATTACH_METADATA_TO_OBJECTS=false
DOCUMENT_STORAGE_SEND_CONTENT_TYPE_HEADER=true

DOCUMENT_STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=3600

DOCUMENT_STORAGE_METRICS_ENABLED=true


# ===== HTTP CLIENT SETTINGS =====

HTTP_CLIENT_DEFAULT_TIMEOUT_SECONDS=30
HTTP_CLIENT_TCP_CONNECT_TIMEOUT_SECONDS=10
HTTP_CLIENT_SOCKET_READ_TIMEOUT_SECONDS=30
HTTP_CLIENT_SOCKET_WRITE_TIMEOUT_SECONDS=60

HTTP_CLIENT_RETRY_MAX_ATTEMPTS=3
HTTP_CLIENT_RETRY_BACKOFF_MIN_SECONDS=1
HTTP_CLIENT_RETRY_BACKOFF_MAX_SECONDS=10

HTTP_CLIENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HTTP_CLIENT_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60

HTTP_CLIENT_CONNECTION_POOL_MAX_SIZE=100
HTTP_CLIENT_CONNECTION_POOL_MAX_KEEPALIVE=20

HTTP_CLIENT_SSL_VERIFY_CERTIFICATES=true
HTTP_CLIENT_FOLLOW_HTTP_REDIRECTS=true

HTTP_CLIENT_REQUEST_USER_AGENT=app/1.0

HTTP_CLIENT_REQUEST_DEFAULT_HEADERS=

HTTP_CLIENT_METRICS_ENABLED=true

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://localhost:8080/auth/validate

# ===== TEXT SPLITTER SETTINGS =====

TEXT_SPLITTER_SPLIT_SIZE=512
TEXT_SPLITTER_SPLIT_OVERLAP=50

TEXT_SPLITTER_MAX_TEXT_LENGTH=10000000

TEXT_SPLITTER_RECURSIVE_ENCODING_NAME=cl100k_base

# ===== EMBEDDER SETTINGS =====

EMBEDDER_OLLAMA_MODEL=nomic-embed-text:v1.5
EMBEDDER_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDER_OLLAMA_REQUEST_TIMEOUT=60
EMBEDDER_OLLAMA_MAX_BATCH_SIZE=100
EMBEDDER_OLLAMA_MAX_TEXT_LENGTH=8000
EMBEDDER_OLLAMA_MAX_RETRIES=3
EMBEDDER_OLLAMA_RETRY_DELAY=1.0
EMBEDDER_OLLAMA_RETRY_MAX_DELAY=10.0
EMBEDDER_OLLAMA_CIRCUIT_BREAKER_THRESHOLD=5
EMBEDDER_OLLAMA_CIRCUIT_BREAKER_TIMEOUT=60

# ===== READER SETTINGS =====

READER_TESSERACT_PATH=
READER_TESSERACT_LANG=spa
READER_TESSERACT_TIMEOUT=300

READER_POPPLER_PATH=

READER_PDF_DPI=300
READER_PDF_USE_PARALLEL=true
READER_PDF_MAX_WORKERS=4
