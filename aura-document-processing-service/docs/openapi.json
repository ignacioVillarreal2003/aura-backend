{
  "openapi": "3.1.0",
  "info": {
    "title": "Aura document processing service",
    "description": "Agent-based document question answering",
    "version": "1.0.0"
  },
  "paths": {
    "/api/document-context/question": {
      "post": {
        "tags": [
          "DocumentContext"
        ],
        "summary": "Execute Retrieve Context Fragments By Question",
        "operationId": "execute_retrieve_context_fragments_by_question_api_document_context_question_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionContextFragmentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextFragmentsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/document-context/document": {
      "post": {
        "tags": [
          "DocumentContext"
        ],
        "summary": "Execute Retrieve Context Fragments By Document",
        "operationId": "execute_retrieve_context_fragments_by_document_api_document_context_document_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentContextFragmentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextFragmentsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/document-creation": {
      "post": {
        "tags": [
          "DocumentCreation"
        ],
        "summary": "Execute Document Creation",
        "operationId": "execute_document_creation_api_document_creation_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_execute_document_creation_api_document_creation_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentCreationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_execute_document_creation_api_document_creation_post": {
        "properties": {
          "raw_document": {
            "type": "string",
            "format": "binary",
            "title": "Raw Document"
          },
          "chat_id": {
            "type": "integer",
            "title": "Chat Id"
          }
        },
        "type": "object",
        "required": [
          "raw_document",
          "chat_id"
        ],
        "title": "Body_execute_document_creation_api_document_creation_post"
      },
      "ContextFragmentsResponse": {
        "properties": {
          "context_fragments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context Fragments"
          }
        },
        "type": "object",
        "required": [
          "context_fragments"
        ],
        "title": "ContextFragmentsResponse"
      },
      "DocumentContextFragmentsRequest": {
        "properties": {
          "document_id": {
            "type": "integer",
            "title": "Document Id"
          }
        },
        "type": "object",
        "required": [
          "document_id"
        ],
        "title": "DocumentContextFragmentsRequest"
      },
      "DocumentCreationResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DocumentCreationResponse"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "pending",
          "done",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionContextFragmentsRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "max_context_fragments": {
            "type": "integer",
            "title": "Max Context Fragments"
          }
        },
        "type": "object",
        "required": [
          "question",
          "max_context_fragments"
        ],
        "title": "QuestionContextFragmentsRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}