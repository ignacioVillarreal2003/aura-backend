# Copy to .env and fill in real values.
# This file is referenced by docker-compose for secrets that span services.

# HuggingFace token (required for model downloads in aura-chat-service and aura-document-processing-service)
HF_TOKEN=                         # https://huggingface.co/settings/tokens

# Gunicorn worker counts (optional — defaults shown)
GUNICORN_WORKERS_AUTH=4
