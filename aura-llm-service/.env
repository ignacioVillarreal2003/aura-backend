APP_NAME="aura llm service"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
ENVIRONMENT=development
SERVICE_API_KEY=service_api_key

# ===== OLLAMA LLM FACADE SETTINGS =====

OLLAMA_LLM_FACADE_MODEL_NAME=gemma4:e2b
OLLAMA_LLM_FACADE_BASE_URL=http://localhost:11434
OLLAMA_LLM_FACADE_NUM_CTX=16384
# Límite de generación acotado: evita respuestas desbocadas.
OLLAMA_LLM_FACADE_NUM_PREDICT=4096
# Temperatura baja = respuestas precisas y reproducibles sobre documentación.
OLLAMA_LLM_FACADE_TEMPERATURE=0.2
OLLAMA_LLM_FACADE_TOP_P=0.9
OLLAMA_LLM_FACADE_TOP_K=40
OLLAMA_LLM_FACADE_REPEAT_PENALTY=1.05
OLLAMA_LLM_FACADE_REQUEST_TIMEOUT=300
# Mantiene el modelo cargado en VRAM entre requests (evita cold-start).
OLLAMA_LLM_FACADE_KEEP_ALIVE=30m

# ===== OLLAMA LLM INVOKER SETTINGS =====

OLLAMA_LLM_INVOKER_MAX_RETRY_ATTEMPTS=3
OLLAMA_LLM_INVOKER_RETRY_MIN_WAIT=1.0
OLLAMA_LLM_INVOKER_RETRY_MAX_WAIT=8.0

# ===== DOCUMENT QUESTION SERVICE SETTINGS =====

DOCUMENT_QUESTION_MAX_CONTEXT_CHARS=12000

# ===== DOCUMENT CONTEXT PROVIDER SETTINGS =====

DOCUMENT_CONTEXT_PROVIDER_QUESTION_CONTEXT_FRAGMENTS_URL=http://localhost:8000/api/v1/fragment-query/by-question
DOCUMENT_CONTEXT_PROVIDER_DOCUMENT_CONTEXT_FRAGMENTS_URL=http://localhost:8000/api/v1/fragment-query/by-documents
DOCUMENT_CONTEXT_PROVIDER_TIMEOUT_SECONDS=120

# ===== GRAPH CONTEXT PROVIDER SETTINGS (KG -> RAG) =====

GRAPH_CONTEXT_PROVIDER_ENABLED=true
GRAPH_CONTEXT_PROVIDER_URL=http://localhost:8000/api/v1/graph/context
GRAPH_CONTEXT_PROVIDER_TIMEOUT_SECONDS=15

# ===== REDIS CLIENT SETTINGS =====

REDIS_CLIENT_URL=redis://127.0.0.1:6379/0

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://localhost:8002/auth/validate
