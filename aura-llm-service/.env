APP_NAME="aura llm service"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ===== OLLAMA LLM FACADE SETTINGS =====

OLLAMA_LLM_FACADE_MODEL_NAME=llama3.1:8b
OLLAMA_LLM_FACADE_BASE_URL=http://localhost:11434

# ===== DOCUMENT CONTEXT PROVIDER SETTINGS =====

DOCUMENT_CONTEXT_PROVIDER_QUESTION_CONTEXT_FRAGMENTS_URL=http://localhost:8000/api/document-query/retrieve-context-fragments-by-question
DOCUMENT_CONTEXT_PROVIDER_DOCUMENT_CONTEXT_FRAGMENTS_URL=http://localhost:8000/api/document-query/retrieve-context-fragments-by-document
DOCUMENT_CONTEXT_PROVIDER_SERVICE_API_KEY=change-me-shared-secret

# ===== INTERNAL SERVICE AUTH (service-to-service inbound) =====
# Must match LLM_PROVIDER_SERVICE_API_KEY in aura-document-processing-service

INTERNAL_SERVICE_API_KEY=change-me-shared-secret

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://localhost:8080/auth/validate
