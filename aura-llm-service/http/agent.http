@llmBase = http://localhost:8001/api/v1
@authToken = user_token_123

### Agente (POST /api/v1/agent) — el último mensaje debe ser role human con contenido no vacío
# @timeout 600
POST {{llmBase}}/agent
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "messages": [
    {
      "role": "human",
      "content": "Mi nombre es Ana."
    },
    {
      "role": "assistant",
      "content": "Hola Ana, ¿en qué puedo ayudarte?"
    },
    {
      "role": "human",
      "content": "¿Te acordás cómo me llamo?"
    }
  ]
}
