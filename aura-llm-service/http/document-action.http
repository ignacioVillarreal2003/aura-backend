# Resumir un documento (con action predefinida)
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Resumime el contenido de este documento",
  "action": "summarize"
}


###


# Extraer puntos clave de un documento
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Dame los puntos más importantes de este documento",
  "action": "key_points"
}


###


# Explicar un documento en términos simples
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Explicame este documento de forma sencilla",
  "action": "explain"
}


###


# Generar un ensayo a partir del documento
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Escribí un ensayo basado en el contenido de este documento",
  "action": "essay"
}


###


# Instrucción libre sin action (el texto guía al LLM)
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Haceme una lista de todas las obligaciones y responsabilidades mencionadas en este documento"
}


###


# Comparar dos documentos
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10, 11],
  "instruction": "Compará estos dos documentos e identificá similitudes y diferencias",
  "action": "compare"
}


###


# Generar un reporte formal
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Generá un reporte formal sobre el contenido de este documento",
  "action": "report"
}


###


# Análisis detallado
# @timeout 600
POST http://localhost:8001/api/document-action
Accept: application/json
Content-Type: application/json
Authorization: Bearer user_token_123

{
  "document_ids": [10],
  "instruction": "Hacé un análisis detallado de este documento",
  "action": "analyze"
}


