APP_NAME="aura llm service"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
ENVIRONMENT=development
SERVICE_API_KEY=service_api_key

# ===== OLLAMA LLM FACADE SETTINGS =====

OLLAMA_LLM_FACADE_MODEL_NAME=gemma4:e2b
OLLAMA_LLM_FACADE_BASE_URL=http://llm:11434

# ===== DOCUMENT CONTEXT PROVIDER SETTINGS =====

DOCUMENT_CONTEXT_PROVIDER_QUESTION_CONTEXT_FRAGMENTS_URL=http://aura-document-processing-service:8000/api/v1/fragment-query/by-question
DOCUMENT_CONTEXT_PROVIDER_DOCUMENT_CONTEXT_FRAGMENTS_URL=http://aura-document-processing-service:8000/api/v1/fragment-query/by-documents

# ===== REDIS CLIENT SETTINGS =====

REDIS_CLIENT_URL=redis://memory_db:6379/3

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://mock-auth:8000/auth/validate
