APP_NAME="aura llm service"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
# El contenedor escucha siempre en 8000 (CMD del Dockerfile); compose lo expone como 8001.
APP_PORT=8000
APP_RELOAD=False
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:4200"]
ENVIRONMENT=production
SERVICE_API_KEY=service_api_key

# ===== OLLAMA LLM FACADE SETTINGS =====

OLLAMA_LLM_FACADE_MODEL_NAME=gemma4:e2b
OLLAMA_LLM_FACADE_BASE_URL=http://llm:11434
# Contexto amplio para RAG con múltiples fragmentos; 32k cabe en VRAM con KV cache q8_0.
OLLAMA_LLM_FACADE_NUM_CTX=32768
# Límite de generación acotado: evita respuestas desbocadas y cuelgues en producción.
OLLAMA_LLM_FACADE_NUM_PREDICT=4096
# Temperatura baja = respuestas precisas y reproducibles sobre documentación.
OLLAMA_LLM_FACADE_TEMPERATURE=0.2
OLLAMA_LLM_FACADE_TOP_P=0.9
OLLAMA_LLM_FACADE_TOP_K=40
OLLAMA_LLM_FACADE_REPEAT_PENALTY=1.05
OLLAMA_LLM_FACADE_REQUEST_TIMEOUT=300
# Mantiene el modelo cargado en VRAM entre requests (evita cold-start de ~30-60s).
OLLAMA_LLM_FACADE_KEEP_ALIVE=-1

# ===== OLLAMA LLM INVOKER SETTINGS =====

OLLAMA_LLM_INVOKER_MAX_RETRY_ATTEMPTS=3
OLLAMA_LLM_INVOKER_RETRY_MIN_WAIT=1.0
OLLAMA_LLM_INVOKER_RETRY_MAX_WAIT=8.0
OLLAMA_LLM_INVOKER_MAX_STREAM_RESPONSE_CHARS=100000

# ===== OLLAMA SERVER (contenedor `llm`, lee este archivo vía env_file) =====

# Atención flash + KV cache cuantizado: menos VRAM y más throughput en GPU.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Mantener los modelos cargados indefinidamente.
OLLAMA_KEEP_ALIVE=-1
# LLM principal + modelo de embeddings pueden convivir cargados.
OLLAMA_MAX_LOADED_MODELS=2
# Requests concurrentes por modelo. El KV cache se multiplica por este valor
# (num_ctx × parallel): con 32k de contexto, subir a 2+ solo si sobra VRAM.
OLLAMA_NUM_PARALLEL=1

# ===== DOCUMENT QUESTION SERVICE SETTINGS =====

DOCUMENT_QUESTION_MAX_CONTEXT_CHARS=20000
DOCUMENT_QUESTION_USE_KEYWORDS=True
DOCUMENT_QUESTION_USE_RERANK=True
DOCUMENT_QUESTION_RERANK_MAX_FRAGMENTS=8
DOCUMENT_QUESTION_ADJACENT_CHUNKS=1

# ===== DOCUMENT CONTEXT PROVIDER SETTINGS =====

DOCUMENT_CONTEXT_PROVIDER_QUESTION_CONTEXT_FRAGMENTS_URL=http://aura-document-processing-service:8000/api/v1/fragment-query/by-question
DOCUMENT_CONTEXT_PROVIDER_DOCUMENT_CONTEXT_FRAGMENTS_URL=http://aura-document-processing-service:8000/api/v1/fragment-query/by-documents
DOCUMENT_CONTEXT_PROVIDER_TIMEOUT_SECONDS=120

# ===== GRAPH CONTEXT PROVIDER SETTINGS (KG -> RAG) =====

GRAPH_CONTEXT_PROVIDER_ENABLED=true
GRAPH_CONTEXT_PROVIDER_URL=http://aura-document-processing-service:8000/api/v1/graph/context
GRAPH_CONTEXT_PROVIDER_TIMEOUT_SECONDS=15

# ===== REDIS CLIENT SETTINGS =====

REDIS_CLIENT_URL=redis://memory_db:6379/3

# ===== AUTHENTICATION PROVIDER SETTINGS =====

AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://aura-auth-service:8000/auth/validate
