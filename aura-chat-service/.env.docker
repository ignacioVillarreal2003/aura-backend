# Aura Chat Service - Docker Environment Variables

# Application
APP_NAME=Aura Chat Service
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql://aura_root:aura_password@db:5432/aura_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Auth Service
AUTH_SERVICE_URL=http://mock-auth:8000

# LLM Service
LLM_SERVICE_URL=http://aura-llm-service:8000
LLM_DEFAULT_MODEL=llama3
LLM_TIMEOUT_SECONDS=600

# Redis
REDIS_URL=redis://memory_db:6379/0

# Storage (MinIO)
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=aura_root
MINIO_SECRET_KEY=aura_password
MINIO_BUCKET=chat-attachments
MINIO_SECURE=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_CONVERSATIONS_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_HOUR=1000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_MESSAGES_PAGE_SIZE=200

# CORS
CORS_ORIGINS=*


