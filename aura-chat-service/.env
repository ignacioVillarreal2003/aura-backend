DJANGO_SETTINGS_MODULE=aura_chat_service.settings.development
SECRET_KEY=django-insecure-docker-chat-change-in-production
DEBUG=True
ALLOWED_HOSTS=aura-chat-service,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

SERVICE_API_KEY=service_api_key

DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

AUTHENTICATION_SERVICE_URL=http://localhost:8002/auth/validate

LLM_DOCUMENT_QUESTION_URL=http://localhost:8001/api/v1/document-question
LLM_DOCUMENT_QUESTION_STREAM_URL=http://localhost:8001/api/v1/document-question/stream
LLM_GENERAL_CHAT_URL=http://localhost:8001/api/v1/general-chat
LLM_GENERAL_CHAT_STREAM_URL=http://localhost:8001/api/v1/general-chat/stream
LLM_RAG_AGENT_URL=http://localhost:8001/api/v1/rag-agent
LLM_RAG_AGENT_STREAM_URL=http://localhost:8001/api/v1/rag-agent/stream
LLM_AGENT_URL=http://localhost:8001/api/v1/agent
LLM_AGENT_STREAM_URL=http://localhost:8001/api/v1/agent/stream
LLM_CHECKLIST_GENERATE_URL=http://localhost:8001/api/v1/checklist-generate
LLM_REPORT_GENERATE_URL=http://localhost:8001/api/v1/report-generate

NOTIFICATION_SERVICE_URL=http://localhost:8004
NOTIFICATION_INTERNAL_API_TOKEN=dev-notification-internal-token
