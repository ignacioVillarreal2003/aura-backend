APP_VERSION=1.0.0
DJANGO_SETTINGS_MODULE=aura_document_collection_service.settings.development
SECRET_KEY=django-insecure-docker-document-collection-change-in-production
DEBUG=True
ALLOWED_HOSTS=aura-document-collection-service,localhost,127.0.0.1

CORS_ORIGINS=*

SERVICE_API_KEY=service_api_key
AUTHENTICATION_PROVIDER_AUTHENTICATION_URL=http://mock-auth:8000/auth/validate

DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=aura_db
DB_PORT=5432

RABBITMQ_MANAGER_URL=amqp://aura_root:aura_password@localhost:5672/

SECURE_SSL_REDIRECT=False
