# Database (aura_db - PostgreSQL on port 5432)
# Use 127.0.0.1 instead of localhost — localhost resolves to ::1 (IPv6) on this machine.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Auth Service (for JWT introspection) — running on port 3000
AUTH_SERVICE_URL=http://127.0.0.1:3000

# Internal token — must match NOTIFICATION_INTERNAL_API_TOKEN in aura-auth-service
NOTIFICATION_INTERNAL_API_TOKEN=dev-notification-internal-token
