SECRET_KEY=django-insecure-local-dev
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (aura_db on PostgreSQL 5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Auth Service (mock-auth on 8080 by default)
AUTHENTICATION_SERVICE_URL=http://127.0.0.1:8080
SERVICE_API_KEY=dev-service-api-key

# Internal token shared with aura-auth-service for admin broadcast
NOTIFICATION_INTERNAL_API_TOKEN=dev-notification-internal-token

# Redis (cache + SSE pub/sub)
REDIS_URL=redis://127.0.0.1:6379/2

# Celery (RabbitMQ broker, Redis result backend)
CELERY_BROKER_URL=amqp://aura_root:aura_password@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# Email (console backend in dev: mails are printed to stdout)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aura <no-reply@aura.local>

# Frontend base URL used by event link builders
NOTIFICATION_DEFAULT_LINK_BASE_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:3000

NOTIFICATION_HARD_DELETE_DAYS=90
ENVIRONMENT=development
