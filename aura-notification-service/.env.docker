SECRET_KEY=django-insecure-docker-secret-change-in-production
DEBUG=True
ALLOWED_HOSTS=aura-notification-service,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=aura_db
DB_PORT=5432

SECURE_SSL_REDIRECT=False

CORS_ALLOWED_ORIGINS=http://localhost:3000

AUTHENTICATION_SERVICE_URL=http://aura-auth-service:8000
SERVICE_API_KEY=dev-service-api-key
NOTIFICATION_INTERNAL_API_TOKEN=dev-notification-internal-token

REDIS_URL=redis://memory_db:6379/2

CELERY_BROKER_URL=amqp://aura_root:aura_password@queue:5672//
CELERY_RESULT_BACKEND=redis://memory_db:6379/3

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aura <no-reply@aura.local>

NOTIFICATION_DEFAULT_LINK_BASE_URL=http://localhost:3000

NOTIFICATION_HARD_DELETE_DAYS=90

ENVIRONMENT=development
