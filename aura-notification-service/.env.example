# Environment Configuration
# Copy this file to .env and fill in values

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (aura_db - PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aura_db
DB_USER=aura_root
DB_PASSWORD=aura_password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth Service URL (for JWT introspection)
AUTH_SERVICE_URL=http://localhost:8000

# Internal token to allow trusted backend-to-backend notification creation
NOTIFICATION_INTERNAL_API_TOKEN=dev-notification-internal-token

# Days before soft-deleted notifications are eligible for hard delete via purge command
NOTIFICATION_HARD_DELETE_DAYS=90

ENVIRONMENT=development
